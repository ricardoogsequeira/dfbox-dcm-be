APP_NAME=dfbox-dcm-be
APP_ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://dcmadmin:change-me@localhost:5432/appdb
CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# GenAI chat proxy configuration. Do not commit real keys.
# In Azure deployment, GENAI_API_KEY must be stored in Key Vault and injected via managed identity/app settings.
GENAI_MODEL_ENDPOINT=
GENAI_API_KEY=
GENAI_MODEL_NAME=
GENAI_API_KEY_HEADER=api-key
GENAI_API_KEY_PREFIX=
GENAI_TIMEOUT_SECONDS=30
